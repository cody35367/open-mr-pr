{
  "name": "open-mr-pr",
  "displayName": "open-mr-pr",
  "description": "This is a vscode extension that provides buttons in the default source control view for opening gitlab and github MR/PRs quickly.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "open-mr-pr.openMrPr",
        "title": "Open MR/PR",
        "icon": "$(link-external)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "open-mr-pr.openMrPr",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "globals": "^17.13.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
